---
layout: layouts/base.njk
---
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Legal</span>
    <h1>{{ title }}</h1>
    <p class="meta">Last updated <time datetime="{{ updated | isoDate }}">{{ updated | readableDate }}</time></p>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <div class="prose">{{ content | safe }}</div>
  </div>
</section>
